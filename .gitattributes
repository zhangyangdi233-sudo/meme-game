# Normalize line endings to LF for all Godot project files.
# This prevents Windows git (autocrlf=true) from converting LF→CRLF on checkout,
# which causes Godot to rewrite every .import file on open and show false diffs.

*.import    text eol=lf
*.gd        text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.cfg       text eol=lf
*.md        text eol=lf

# Binary assets — never touch line endings
*.png       binary
*.wav       binary
*.ogg       binary
*.ttf       binary
*.otf       binary

# Large source and imported 3D/video assets live in Git LFS.
# Existing PNG/WAV/OGG history stays as regular blobs; only these new kinds go to LFS.
*.blend     filter=lfs diff=lfs merge=lfs -text
*.blend1    filter=lfs diff=lfs merge=lfs -text
*.glb       filter=lfs diff=lfs merge=lfs -text
*.gltf      filter=lfs diff=lfs merge=lfs -text
*.fbx       filter=lfs diff=lfs merge=lfs -text
*.ogv       filter=lfs diff=lfs merge=lfs -text
*.mp4       filter=lfs diff=lfs merge=lfs -text
assets/chapter1/**/*.png    filter=lfs diff=lfs merge=lfs -text
source_assets/**            filter=lfs diff=lfs merge=lfs -text
# ...except the notes that sit beside the sources, which stay readable text.
source_assets/**/*.md       !filter !diff !merge text eol=lf
source_assets/**/.gdignore  !filter !diff !merge text eol=lf

# Content carried over from main (#141). Keep the planner's originals and the
# narrative drafts byte-exact; office files and the large HTML go to LFS.
/docs/narrative/** -text
/docs/design_originals/** -text
*.docx      filter=lfs diff=lfs merge=lfs -text
*.pdf       filter=lfs diff=lfs merge=lfs -text
docs/narrative/*.html filter=lfs diff=lfs merge=lfs -text
