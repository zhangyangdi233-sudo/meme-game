# Normalize line endings to LF for all Godot project files.
# This prevents Windows git (autocrlf=true) from converting LF→CRLF on checkout,
# which causes Godot to rewrite every .import file on open and show false diffs.

*.import    text eol=lf
*.gd        text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.cfg       text eol=lf
*.md        text eol=lf

# Binary assets — never touch line endings
*.png       binary
*.wav       binary
*.ogg       binary
*.ttf       binary
*.otf       binary
